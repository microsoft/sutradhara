+class PriorityFreeKVCacheBlockQueue:
+    def __init__(self, blocks: list[KVCacheBlock]) -> None:
+        self.priority_free_kv_cache_block_queues = {}
+        self.num_free_blocks = len(blocks)
+        queues = self.priority_free_kv_cache_block_queues
+        for block_type in KVBlockType:
+            initial = blocks if block_type == KVBlockType.BASELINE else []
+            queues[block_type] = FreeKVCacheBlockQueue(initial)
+
+    def append(self, block: KVCacheBlock) -> None:
+        self.priority_free_kv_cache_block_queues[block.type].append(block)
+        self.num_free_blocks += 1
+
+    def append_n(self, blocks: list[KVCacheBlock]):
+        if not blocks:
+            return
+        # Route each block to its type's sub-queue. Single loop, no
+        # grouping/allocation overhead.  ~200µs for 4000 blocks (64K tokens)
+        # which is <0.5% of a forward pass at that length.
+        queues = self.priority_free_kv_cache_block_queues
+        for block in blocks:
+            queues[block.type].append(block)
+        self.num_free_blocks += len(blocks)
+
+    def popleft(self) -> KVCacheBlock:
+        blocks_freed = self.popleft_n(1)
+        assert len(blocks_freed) == 1
+        return blocks_freed[0]
+
+    def popleft_n(self, n) -> list[KVCacheBlock]:
+        blocks_freed_list = []
+        queues = self.priority_free_kv_cache_block_queues
+        # Iterate in definition order: lowest eviction priority first.
+        for block_type in KVBlockType:
+            if n <= 0:
+                break
+            free_block_queue = queues[block_type]
+            num_to_pop = min(n, free_block_queue.num_free_blocks)
+            if num_to_pop == 0:
+                continue
+            blocks_freed = free_block_queue.popleft_n(num_to_pop)
+            blocks_freed_list.extend(blocks_freed)
+            n -= len(blocks_freed)
+
+        self.num_free_blocks -= len(blocks_freed_list)
+        return blocks_freed_list
+
+    def remove(self, block: KVCacheBlock) -> None:
+        self.priority_free_kv_cache_block_queues[block.type].remove(block)
+        self.num_free_blocks -= 1
 
