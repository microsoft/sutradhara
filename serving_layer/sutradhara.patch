+        start_block_idx: int = 0,
+    ) -> None:
+        """Label KV blocks for a request using orchestrator hints.
+
+        Only processes blocks from *start_block_idx* onwards so that
+        chunked-prefill steps pay O(new_blocks * L) instead of O(B * L).
+        When a block spans two hint regions the higher-priority type wins.
+        """
+        if not request.orchestrator_hints or self.block_size is None:
+            return
+
+        block_size = self.block_size
+
+        # Sort hints by start token — O(H log H), H is typically 3-10.
+        sorted_hints = sorted(request.orchestrator_hints.items(),
+                              key=lambda item: item[0][0])
+        num_hints = len(sorted_hints)
+
+        num_blocks = len(all_blocks[0]) if all_blocks else 0
+        block_labels: list[Optional[KVBlockType]] = [None] * num_blocks
+
+        # Advance hint_idx past hints that end before start_block_idx.
+        hint_idx = 0
+        if start_block_idx > 0:
+            start_token = start_block_idx * block_size
+            while hint_idx < num_hints and (
+                    sorted_hints[hint_idx][0][1] <= start_token):
+                hint_idx += 1
+
+        for block_idx in range(start_block_idx, num_blocks):
+            block_start = block_idx * block_size
+            block_end = block_start + block_size
+
+            # Advance past hints that end at or before this block.
+            while hint_idx < num_hints and (
+                    sorted_hints[hint_idx][0][1] <= block_start):
+                hint_idx += 1
+
