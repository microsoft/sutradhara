+def _merge_prefill_into_decode_metrics(decode_metrics, prefill_metrics,
+                                       proxy_timing):
+    """Merge prefill-side metrics into the decode metrics dict in-place.
+
+    After merging, ``decode_metrics`` contains the *combined* view of
+    waiting time, batch composition, preemption state, and a nested
+    ``prefill_metrics`` dict for detailed analysis.
+    """
+    if not prefill_metrics:
+        return
+
+    # Combined waiting time: prefill queue + decode queue + proxy overhead
+    prefill_wait = prefill_metrics.get("waiting_time") or 0.0
+    decode_wait = decode_metrics.get("waiting_time") or 0.0
+    decode_metrics["waiting_time"] = (
+        prefill_wait + decode_wait
+        + proxy_timing.get("proxy_overhead_ms", 0.0)
+    )
+
+    # Prepend prefill batch_metrics so the orchestrator sees the full picture
+    prefill_batches = prefill_metrics.get("batch_metrics") or []
+    decode_batches = decode_metrics.get("batch_metrics") or []
+    if prefill_batches:
+        decode_metrics["batch_metrics"] = prefill_batches + decode_batches
+
+    # Preemption: true if *either* side was preempted
+    if prefill_metrics.get("preempted"):
+        decode_metrics["preempted"] = True
+
+    prefill_preempt = prefill_metrics.get("time_spent_in_preemption_ms") or 0.0
+    decode_preempt = decode_metrics.get("time_spent_in_preemption_ms") or 0.0
+    if prefill_preempt > 0:
+        decode_metrics["time_spent_in_preemption_ms"] = (
+            prefill_preempt + decode_preempt
+        )
+
+    # Expose the prefill-side KV cache hit (the meaningful metric for
+    # prefix-caching analysis — the decode side always sees ~100% after
+    # KV transfer).
+    if "kv_cache_hit_percentage" in prefill_metrics:
+        decode_metrics["prefill_kv_cache_hit_percentage"] = (
+            prefill_metrics["kv_cache_hit_percentage"]
+        )
+
+    # Stash the full prefill metrics + proxy timing for detailed analysis
+    decode_metrics["prefill_metrics"] = {
+        **prefill_metrics,
+        **proxy_timing,
+    }
+
+
+def _patch_sse_event(event_bytes, prefill_metrics, proxy_timing):
+    """If *event_bytes* is an SSE data chunk containing ``metrics``, merge
+    prefill data into it.  Otherwise return the bytes unchanged."""
+    event_str = event_bytes.decode("utf-8", errors="replace").strip()
+    if not event_str or not event_str.startswith("data: "):
+        return event_bytes
+
+    data_str = event_str[6:]
+    if data_str.strip() == "[DONE]":
+        return event_bytes
+
+    try:
+        parsed = json.loads(data_str)
+    except (json.JSONDecodeError, ValueError):
+        return event_bytes
+
+    if parsed.get("metrics") is None:
+        return event_bytes
+
+    _merge_prefill_into_decode_metrics(parsed["metrics"],
+                                       prefill_metrics, proxy_timing)
+    return ("data: " + json.dumps(parsed)).encode()
+
