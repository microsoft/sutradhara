+                if best_type is None or hint_type.value > best_type.value:
+                    best_type = hint_type
+                j += 1
+
+            block_labels[block_idx] = best_type
+
+        # Apply labels only to new blocks — O(new_blocks * L).
+        for layer_blocks in all_blocks:
+            for block_idx in range(start_block_idx, len(layer_blocks)):
