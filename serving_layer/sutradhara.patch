diff --git a/vllm/v1/core/kv_block_types.py b/vllm/v1/core/kv_block_types.py
new file mode 100644
index 0000000..f6097f4
--- /dev/null
+++ b/vllm/v1/core/kv_block_types.py
@@ -0,0 +1,32 @@
+from enum import Enum
+
+
+class KVBlockType(Enum):
+    """KV-block eviction tiers, low->high priority (first evicted first)."""
+
+    BASELINE = -1      # unlabeled decode output; evicted first
+    RESPONSE = 0       # reserved; not emitted by the partitioner
+    NO_PRIORITY = 1
+    TOOL_OUTPUT = 2    # conversation history; bulk of the reusable prefix
+    USER_QUERY = 3     # user message; eviction cascades to later blocks
+    SYSTEM_PROMPT = 4  # system prompt + tool defs; shared across requests
+    SPLIT_A = 5        # pinned prefill prefix; evicted last
+
+
+BLOCK_TYPE_NAMES: dict[str, int] = {
+    "split_a": KVBlockType.SPLIT_A.value,
+    "system_prompt": KVBlockType.SYSTEM_PROMPT.value,
+    "user_query": KVBlockType.USER_QUERY.value,
+    "tool_output": KVBlockType.TOOL_OUTPUT.value,
+    "no_priority": KVBlockType.NO_PRIORITY.value,
+    "response": KVBlockType.RESPONSE.value,
+}
+
+
+def parse_block_type(type_str: str) -> int:
+    """Convert an API block-type string to its enum value."""
+    if type_str not in BLOCK_TYPE_NAMES:
+        valid = ", ".join(BLOCK_TYPE_NAMES)
+        raise ValueError(
+            f"Unknown block type: '{type_str}'. Valid types: {valid}")
+    return BLOCK_TYPE_NAMES[type_str]
